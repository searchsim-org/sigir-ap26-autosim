# AutoSim configuration. Copy to `.env` and fill in your own values.
# load_env() reads this file and merges it with the process environment.
# Nothing here is committed with real values; provide your own gateway and index.

# --- LLM gateway (OpenAI-compatible; generation, judging, reranking) ---
CUSTOM_LLM_ENDPOINT=https://your-llm-gateway.example.com
CUSTOM_LLM_API_KEY=your-api-key-here

# --- Retrieval index (OpenSearch over the retrieval corpus) ---
OPENSEARCH_HOST=your-opensearch-host.example.com
CLUEWEB22_READER=your-opensearch-reader-password

# --- Optional: SPLADE learned-sparse endpoint ---
SPLADE_URL=

# --- Optional model overrides (defaults are chat-routable open-weight models) ---
# AUTOSIM_GEN_MODEL=qwen3-next-80b-a3b-instruct
# AUTOSIM_JUDGE_MODEL=gemma4-31b-it

# --- Experiments (weight-level self-improvement, GPU) ---
# AUTOSIM_WEIGHT_MODEL=Qwen/Qwen2.5-3B-Instruct
# AUTOSIM_WEIGHT_TAG=
